<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bb_blue">#FF00A8DF</color>
    <color name="bb_bg">#FF121212</color>

    <string name="a11y_desc">Adds BlackBerry 10 gestures (swipe up from the bottom edge to minimize, swipe up and right to peek at the Hub) and captures app snapshots for Active Frames. Nothing leaves your device.</string>

    <style name="Theme.BB10" parent="android:Theme.DeviceDefault.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:colorAccent">@color/bb_blue</item>
        <item name="android:colorControlActivated">@color/bb_blue</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:alertDialogTheme">@style/Theme.BB10.Dialog</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>

    <style name="Theme.BB10.Lock" parent="Theme.BB10">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.BB10.Dialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:colorAccent">@color/bb_blue</item>
        <item name="android:colorControlActivated">@color/bb_blue</item>
    </style>

    <style name="Theme.BB10.Phone" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:windowBackground">@color/bb_bg</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:colorAccent">@color/bb_blue</item>
        <item name="android:colorControlActivated">@color/bb_blue</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.BB10.Kit" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:colorAccent">@color/bb_blue</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:alertDialogTheme">@style/Theme.BB10.Dialog</item>
    </style>

    <style name="Theme.BB10.Settings" parent="android:Theme.DeviceDefault">
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:colorAccent">@color/bb_blue</item>
        <item name="android:colorPrimary">#FF262626</item>
        <item name="android:colorPrimaryDark">#FF000000</item>
        <item name="android:colorControlActivated">@color/bb_blue</item>
        <item name="android:windowBackground">@color/bb_bg</item>
        <item name="android:alertDialogTheme">@style/Theme.BB10.Dialog</item>
    </style>
</resources>
